PORT=8080
# Instâncias do backend, separadas por vírgula (o gateway distribui a carga entre elas)
UPSTREAMS=http://localhost:3000
# round-robin (revezamento) ou least-connections (a instância mais livre)
LB_STRATEGY=round-robin
# Atrás de outro proxy (Nginx, balanceador da nuvem): usa o IP do visitante informado por ele
# TRUST_PROXY=true
# Origens extras que podem enviar POST/PATCH/DELETE (proteção contra CSRF)
# ALLOWED_ORIGINS=https://app.meusite.com
# Limite geral por IP (os limites de login e do proxy de imagens vêm do manifesto da API)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=600
# BODY_LIMIT_BYTES=1048576
# UPSTREAM_TIMEOUT_MS=60000
# HEALTH_INTERVAL_MS=5000
