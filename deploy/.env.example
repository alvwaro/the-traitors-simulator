# Copie para .env nesta pasta (cp .env.example .env) e preencha. O .env nunca vai para o Git.

# Onde estão as imagens (publicadas pelo GitHub Actions, em minúsculas) e qual versão rodar:
# "latest" (a última da main) ou o hash de um commit, para voltar a uma versão anterior.
IMAGE_REGISTRY=ghcr.io/alvwaro
IMAGE_TAG=latest

# Endereço do site:
#   traitors.meudominio.com   → HTTPS automático (o domínio precisa apontar para o IP da EC2)
#   1-2-3-4.sslip.io          → HTTPS sem comprar domínio (troque 1-2-3-4 pelo IP elástico, com hífens)
#   :80                       → só HTTP pelo IP (apenas para testar)
SITE_ADDRESS=:80
# true com HTTPS; false quando SITE_ADDRESS=:80 (senão o login não funciona)
COOKIE_SECURE=false

# Banco. A senha vai dentro da DATABASE_URL: use só letras e números. Gere com: openssl rand -hex 24
POSTGRES_USER=traitors
POSTGRES_PASSWORD=
POSTGRES_DB=traitors
