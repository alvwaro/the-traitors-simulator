PORT=3000
# Use as mesmas credenciais do .env da raiz (docker-compose)
DATABASE_URL=postgres://traitors:troque-esta-senha@localhost:5433/traitors
DATABASE_POOL_MAX=10
# Produção (HTTPS): cookie de sessão só por HTTPS. Padrão: ligado quando NODE_ENV=production
# COOKIE_SECURE=true
# Atrás de um proxy (Render, Railway, Nginx): usa o IP real no limite de tentativas de login
# TRUST_PROXY=true
