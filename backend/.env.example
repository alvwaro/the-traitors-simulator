PORT=3000
# Use as mesmas credenciais do .env da raiz (docker-compose)
DATABASE_URL=postgres://traitors:troque-esta-senha@localhost:5433/traitors
DATABASE_POOL_MAX=10
# Produção (HTTPS): cookie de sessão só por HTTPS. Padrão: ligado quando NODE_ENV=production
# COOKIE_SECURE=true
# Atrás de um proxy (Render, Railway, Nginx): usa o IP real no limite de tentativas de login
# TRUST_PROXY=true
# Origens extras (além do próprio host) que podem enviar POST/PATCH/DELETE (proteção contra CSRF)
# ALLOWED_ORIGINS=https://app.meusite.com
# Desligamento gracioso: espera antes de fechar a porta (o balanceador tira a instância) e limite para terminar
# SHUTDOWN_DRAIN_MS=0
# SHUTDOWN_TIMEOUT_MS=10000
# Worker (npm run dev:worker): intervalo entre as buscas na fila de trabalhos
# JOB_POLL_MS=1000
